XAI_API_KEY=sk-your-xai-key

# WaveSpeed unified API (Grok Imagine + Seedream 5-lite for source images)
# WAVESPEED_API_KEY=your-wavespeed-key
# WAVESPEED_API_BASE=https://api.wavespeed.ai/api/v3

# Comma-separated browser origins allowed to call the API (required in production).
# CORS_ORIGINS=https://scratchie.example.com

# Optional overrides
# MESH_DEVICE=cpu
# GROK_API_KEY=sk-your-xai-key
# XAI_API_BASE=https://api.x.ai
# XAI_VIDEO_EDIT_MODEL=grok-imagine-video
# XAI_VIDEO_MODEL=grok-imagine-video-1.5
# SOURCE_IMAGE_PROVIDER=wavespeed
# SOURCE_IMAGE_MODEL=seedream-v5-lite
# BACKGROUND_VIDEO_MODEL=wan-2.2-spicy
